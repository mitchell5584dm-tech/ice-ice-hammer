# Copy to .env and fill in. Real environment variables override this file.

# Required. Create one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Required in production. Signs session cookies; changing it logs everyone out.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the SQLite DB and audio files live. Use a persistent disk in production.
DATA_DIR=./data

PORT=3000
MAX_ACTIVE_GENERATIONS=6
# Per-user cap on simultaneous generations.
USER_MAX_ACTIVE_GENERATIONS=2

# Email verification: set to 1 to skip the magic-link step (local dev / tests only).
# Otherwise the verification link is logged to the server console (stub).
EMAIL_AUTO_VERIFY=

# Optional: any account signing up with this email is made an admin.
# (The very first account is always admin.)
ADMIN_EMAIL=

# Optional: set to 1 when serving behind HTTPS so the session cookie is Secure.
COOKIE_SECURE=

# ---- Stripe billing (Phase 2) ----
# Get these from https://dashboard.stripe.com (use TEST keys first).
# Without STRIPE_SECRET_KEY the app runs fine but /api/billing/* returns 503.
STRIPE_SECRET_KEY=
# Webhook signing secret for the endpoint POST /api/billing/webhook
# (Dashboard → Developers → Webhooks → Add endpoint → select events:
#  checkout.session.completed, invoice.paid, invoice.payment_failed,
#  customer.subscription.deleted, charge.refunded).
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs (Dashboard → Product catalog). Create:
#  - 3 recurring prices: Starter $4.99/mo, Creator $8.99/mo, Pro $19.99/mo
#  - 1 one-time price: 100-credit pack $6.99
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PACK=

# Test/dev only: set to 1 to use an in-process fake Stripe client (no network,
# no keys needed). Webhook signature verification still runs for real.
STRIPE_MOCK=

# ---- Creator referrals ----
# Canonical public base URL for referral links (/r/CODE). Falls back to the
# request Host header when unset; set this to your domain in production.
APP_BASE_URL=

# Stripe Connect must be enabled in the dashboard for referral payouts
# (GET /api/referrals/connect, POST /api/referrals/payout) to work.
